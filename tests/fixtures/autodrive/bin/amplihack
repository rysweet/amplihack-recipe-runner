#!/usr/bin/env bash
# Stand-in for `amplihack orch helper extract-json` / `extract-field`.
#
# The consuming step in `autodrive-crusty-loop` pipes the preflight JSON
# through these two subcommands. `amplihack` is not a dependency of this
# repository and is absent in CI, and this test must not skip when it is
# missing, so the fixture supplies them and is placed first on PATH. See
# PROVENANCE.md.
set -uo pipefail

if [ "${1:-}" != "orch" ] || [ "${2:-}" != "helper" ]; then
  echo "amplihack shim: only 'orch helper ...' is implemented; got: $*" >&2
  exit 2
fi
sub="${3:-}"
shift 3

case "$sub" in
  extract-json)
    field=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --require-field) field="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    FIELD="$field" python3 -c '
import json, os, sys

text = sys.stdin.read()
field = os.environ.get("FIELD", "")

# Collect every balanced top-level {...} run that parses as JSON, in document
# order, ignoring braces inside strings.
objs = []
depth = 0
start = None
in_str = False
esc = False
for i, ch in enumerate(text):
    if in_str:
        if esc:
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == "\"":
            in_str = False
        continue
    if ch == "\"":
        in_str = True
    elif ch == "{":
        if depth == 0:
            start = i
        depth += 1
    elif ch == "}" and depth > 0:
        depth -= 1
        if depth == 0 and start is not None:
            try:
                objs.append(json.loads(text[start:i + 1]))
            except ValueError:
                pass
            start = None

out = {}
if field:
    # Last object carrying the field wins, matching the real subcommand.
    for o in objs:
        if isinstance(o, dict) and field in o:
            out = o
elif objs:
    out = objs[0]
sys.stdout.write(json.dumps(out, separators=(",", ":")) + "\n")
'
    ;;
  extract-field)
    field=""
    default=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --field) field="${2:-}"; shift 2 ;;
        --default) default="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    FIELD="$field" DEFAULT="$default" python3 -c '
import json, os, sys

field = os.environ.get("FIELD", "")
default = os.environ.get("DEFAULT", "")
try:
    data = json.loads(sys.stdin.read())
except ValueError:
    data = None
if isinstance(data, dict) and field in data and data[field] is not None:
    v = data[field]
    v = v if isinstance(v, str) else json.dumps(v, separators=(",", ":"))
else:
    v = default
sys.stdout.write(v + "\n")
'
    ;;
  *)
    echo "amplihack shim: unsupported subcommand: $sub" >&2
    exit 2
    ;;
esac
